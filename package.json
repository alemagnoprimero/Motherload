{
  "name": "motherload-remake",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:browser": "node scripts/browser-test.mjs",
    "reference": "vite --host 0.0.0.0 --port 4174",
    "format:check": "prettier --check src tests scripts/*.mjs index.html reference/index.html"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@ruffle-rs/ruffle": "0.7.1",
    "playwright-core": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
