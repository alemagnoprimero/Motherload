{
  "name": "the-deep-frontier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run campaign:check && tsc --noEmit && vite build",
    "assets:build": "npm run campaign:assets",
    "assets:check": "node scripts/check-campaign-assets.mjs && node scripts/check-frontier-assets.mjs && node scripts/check-render-assets.mjs",
    "campaign:check": "node scripts/check-campaign-data.mjs && npm run assets:check",
    "campaign:assets": "node scripts/build-campaign-assets.mjs",
    "frontier:assets": "node scripts/build-frontier-assets.mjs",
    "test:campaign": "vitest run tests/campaign-*.test.ts",
    "test:campaign:browser": "node scripts/campaign-smoke.mjs",
    "test:campaign:storage": "node scripts/campaign-storage-smoke.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:browser": "node scripts/campaign-smoke.mjs",
    "test:usability": "node scripts/usability-smoke.mjs",
    "test:poi": "node scripts/poi-smoke.mjs",
    "test:frontier": "node scripts/frontier-smoke.mjs",
    "test:improvements": "node scripts/improvement-smoke.mjs",
    "test:opening": "vitest run tests/campaign-improvements-model.test.ts tests/campaign-model.test.ts",
    "reference": "vite --host 0.0.0.0 --port 4174",
    "format:check": "prettier --check src tests scripts/*.mjs index.html reference/index.html",
    "test:production": "node scripts/production-smoke.mjs",
    "test:pacing": "node scripts/run-pacing.mjs",
    "test:pacing:nightly": "node scripts/run-pacing.mjs --nightly",
    "test:feel": "node scripts/feel-smoke.mjs",
    "test:audio": "node scripts/audio-smoke.mjs",
    "render:assets": "node scripts/build-band-assets.mjs",
    "test:plan-ui": "node scripts/plan-ui-smoke.mjs",
    "test:render": "node scripts/render-acceptance.mjs",
    "test:render:memory": "node scripts/render-memory.mjs",
    "test:camera": "node scripts/camera-smoke.mjs",
    "test:hud:surface": "node scripts/hud-surface-smoke.mjs",
    "test:opening:browser": "node scripts/audit-opening.mjs",
    "test:surface:render": "node scripts/surface-render-smoke.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@ruffle-rs/ruffle": "0.7.1",
    "playwright-core": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
