{
  "source": "docs/art-direction/d0-target-board.png",
  "source_sha256": "e293cb300b3b75b2c3bab47db1d766ec9ec613aecd1351470e63ac110c58abda",
  "made": "2026-11-03, Adobe Photoshop API through the Adobe connector (image_crop_to_bounds); every crop checked pixel-identical to the board inside its window. Adobe adds XMP, an sRGB ICC profile and a C2PA provenance link; pixels are unchanged.",
  "coordinates": "window: board pixels [x0, y0, x1, y1), exclusive ends. interior, hud_mask, rig_box and rig_anchor: pixels of that crop.",
  "rule": "Each window has the size given in ART_QUALITY_AUDIT.md \u00a74.3 and is centred on the panel border-stroke centrelines (luma-weighted). This reproduces the surface box in docs/art-audit/data/measure.json.",
  "fields": {
    "game_window": "The matching scoring window on a game capture (\u00a74.3).",
    "stroke_span": "Width and height between the panel border-stroke centrelines.",
    "interior": "Inside the border strokes. Use it, minus hud_mask, for statistics; the rounded corners still hold a few border pixels.",
    "hud_mask": "Generous rectangles over the board HUD, to exclude it from statistics. Desktop boxes follow CONCEPT_HUD in docs/art-audit/prototype/metrics.py.",
    "rig_anchor": "Centre of the rig bounding box (hull, tracks and drill bit; not the lamp light), read at 6 to 7x zoom, about 1 px either way. Crop each game capture so the rig sits at the same rig_anchor_fraction of its game_window."
  },
  "notes": [
    "Shaft row: the panel is 353.5 px tall between stroke centrelines, 4.5 px less than the 358 in \u00a74.3, so its 358-row window takes in the border strokes and 1 to 2 rows of page background at top and bottom. interior excludes them.",
    "Surface and cavern rows: the window holds the border strokes at its edges; interior excludes them."
  ],
